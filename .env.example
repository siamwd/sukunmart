# Copy to .env and replace these with the connection strings from Neon.
# Use the pooled connection string for the app and the direct connection for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require"

# Used ONLY by `npm run admin:create` (initial administrator)
ADMIN_EMAIL="mdmahfujur295@gmail.com"

# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin session lifetime in hours
ADMIN_SESSION_HOURS="8"
